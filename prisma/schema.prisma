generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Partner {
  id              String           @id @default(uuid())
  name            String
  region          String
  interest        String
  status          String           @default("NEW")
  lastContactAt   DateTime?
  humanRequired   Boolean          @default(false)
  contactName     String?
  contactEmail    String?
  contactTitle    String?
  partnerType     String           @default("PHARMA")  // PHARMA | BIOTECH | INVESTOR | OTHER
  messages        Message[]
  drafts          Draft[]
  emailValidation EmailValidation?
  createdAt       DateTime         @default(now())
}

model Message {
  id        String   @id @default(uuid())
  partnerId String
  direction String
  body      String
  createdAt DateTime @default(now())
  Partner   Partner  @relation(fields: [partnerId], references: [id])
}

model Draft {
  id         String    @id @default(uuid())
  partnerId  String
  region     String
  category   String
  subject    String?
  body       String
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  sentAt     DateTime?
  Partner    Partner   @relation(fields: [partnerId], references: [id])
}

model EmailValidation {
  id        String   @id @default(uuid())
  partnerId String   @unique
  status    String   // VALID, INVALID, NO_EMAIL
  reason    String?
  checkedAt DateTime @default(now())
  Partner   Partner  @relation(fields: [partnerId], references: [id])
}
